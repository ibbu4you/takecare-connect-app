# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# The upload key. Never commit either of these.
#
# Anyone holding them can publish an update to this app under the foundation's
# name, and Play ties the listing to the key's fingerprint — lose it and the app
# can only be re-published as a different listing that existing users have to
# find and install again.
android/key.properties
**/*.jks
**/*.keystore

# store/ is committed on purpose — the Play listing artwork is generated from
# the logo asset and should be reproducible from the repository, not from
# whoever happened to have the files on their laptop.
